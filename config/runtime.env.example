# Safe production defaults. Copy values into your private environment; do not commit .env files.
NLVE_ENV=production
NLVE_LIVE_SEARCH_ENABLED=0
NLVE_LIVE_SEND_ENABLED=0
NLVE_GOOGLE_DRIVE_ENABLED=0
# Required before enabling live search or send. Keep the completed record outside the repository.
NLVE_PROVIDER_APPROVAL_PATH=C:\private\nlvoorelkaar_provider_approval.json
NLVE_MAX_SEARCH_PAGES=5
NLVE_MAX_SEND_BATCH=5
NLVE_DAILY_SEND_LIMIT=20

# Authenticated local web application. Generate a random value; do not reuse an account password.
NLVE_WEB_API_TOKEN=replace-with-at-least-32-random-characters
NLVE_WEB_TRUSTED_HOSTS=localhost,127.0.0.1

# Optional private paths for explicitly enabled Google Drive backup.
NLVE_GOOGLE_CLIENT_SECRET_PATH=C:\private\google_credentials.json
NLVE_GOOGLE_TOKEN_PATH=C:\private\google_token.json
